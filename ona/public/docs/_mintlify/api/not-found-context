acity: 2.5;\n}\n\n.veto-banner:hover .veto-col {\n\tcolor: rgba(255, 255, 255, 0.25);\n}\n\n.veto-banner:hover .veto-title {\n\tcolor: #ffffff;\n}\n\n.veto-banner:hover .veto-subtitle {\n\tcolor: rgba(255, 255, 255, 0.75);\n}\n\n.veto-content {\n\tposition: relative;\n\tz-index: 2;\n}\n\n.veto-title {\n\tfont-size: 15px;\n\tfont-weight: 700;\n\tcolor: #ffffff;\n\tmargin-bottom: 4px;\n\ttransition: color 0.4s ease;\n}\n\n.veto-subtitle {\n\tfont-size: 14px;\n\tcolor: rgba(255, 255, 255, 0.55);\n\tline-height: 1.5;\n\ttransition: color 0.4s ease;\n}\n\n/* Matrix rain columns */\n.veto-rain {\n\tposition: absolute;\n\tinset: 0;\n\tpointer-events: none;\n\tuser-select: none;\n\toverflow: hidden;\n}\n\n.veto-col {\n\tposition: absolute;\n\ttop: -100%;\n\tfont-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;\n\tfont-size: 13px;\n\tline-height: 1.4;\n\tcolor: rgba(255, 255, 255, 0.1);\n\twriting-mode: vertical-lr;\n\ttext-orientation: upright;\n\tanimation: veto-fall linear infinite;\n\ttransition: color 0.4s ease;\n}\n\n.veto-col:nth-child(1)  { left: 2%;  animation-duration: 6s;   animation-delay: 0s; }\n.veto-col:nth-child(2)  { left: 7%;  animation-duration: 8s;   animation-delay: -2s;   color: rgba(255, 255, 255, 0.06); }\n.veto-col:nth-child(3)  { left: 12%; animation-duration: 7s;   animation-delay: -4s; }\n.veto-col:nth-child(4)  { left: 17%; animation-duration: 9s;   animation-delay: -1s;   color: rgba(255, 255, 255, 0.08); }\n.veto-col:nth-child(5)  { left: 22%; animation-duration: 6.5s; animation-delay: -3s; }\n.veto-col:nth-child(6)  { left: 27%; animation-duration: 8.5s; animation-delay: -5s;   color: rgba(255, 255, 255, 0.05); }\n.veto-col:nth-child(7)  { left: 32%; animation-duration: 7.5s; animation-delay: -2.5s; }\n.veto-col:nth-child(8)  { left: 37%; animation-duration: 9.5s; animation-delay: -4.5s; color: rgba(255, 255, 255, 0.06); }\n.veto-col:nth-child(9)  { left: 42%; animation-duration: 6.8s; animation-delay: -1.5s; }\n.veto-col:nth-child(10) { left: 47%; animation-duration: 8.2s; animation-delay: -3.5s; color: rgba(255, 255, 255, 0.08); }\n.veto-col:nth-child(11) { left: 52%; animation-duration: 7.2s; animation-delay: -0.5s; }\n.veto-col:nth-child(12) { left: 57%; animation-duration: 9s;   animation-delay: -5.5s; color: rgba(255, 255, 255, 0.05); }\n.veto-col:nth-child(13) { left: 62%; animation-duration: 6.3s; animation-delay: -2.8s; }\n.veto-col:nth-child(14) { left: 67%; animation-duration: 7.8s; animation-delay: -1.2s; color: rgba(255, 255, 255, 0.08); }\n.veto-col:nth-child(15) { left: 72%; animation-duration: 8.8s; animation-delay: -3.8s; }\n.veto-col:nth-child(16) { left: 77%; animation-duration: 6.2s; animation-delay: -4.2s; color: rgba(255, 255, 255, 0.06); }\n.veto-col:nth-child(17) { left: 82%; animation-duration: 7.6s; animation-delay: -0.8s; }\n.veto-col:nth-child(18) { left: 87%; animation-duration: 9.2s; animation-delay: -2.2s; color: rgba(255, 255, 255, 0.05); }\n.veto-col:nth-child(19) { left: 92%; animation-duration: 6.7s; animation-delay: -4.8s; }\n.veto-col:nth-child(20) { left: 97%; animation-duration: 8.4s; animation-delay: -1.8s; color: rgba(255, 255, 255, 0.08); }\n\n@keyframes veto-fall {\n\t0%   { transform: translateY(0); }\n\t100% { transform: translateY(300%); }\n}\n"}],"jsFiles":[{"_id":"67c5901c0023781f11cd8ac8","filePath":"mux-player.js","subdomain":"gitpod-13c83c2b","__v":0,"content":"// Function to initialize Mux players\nfunction initMuxPlayers() {\n\t// Check if Mux script is already loaded\n\tif (window.customElements && customElements.get('mux-player')) {\n\t\tsetupPlayers();\n\t} else {\n\t\t// Load the script if not already loaded\n\t\tconst muxScript = document.createElement('script');\n\t\tmuxScript.src = 'https://cdn.jsdelivr.net/npm/@mux/mux-player';\n\t\tmuxScript.async = true;\n\t\tmuxScript.onload = setupPlayers;\n\t\tdocument.head.appendChild(muxScript);\n\t}\n}\n\n// Function to set up all players on the page\nfunction setupPlayers() {\n\tdocument.querySelectorAll('.mux-player-container').forEach((container) => {\n\t\tconst playbackId = container.getAttribute('data-playback-id');\n\t\tconst videoTitle = container.getAttribute('data-title') || '';\n\t\tconst thumbnailTime = container.getAttribute('data-thumbnail-time');\n\n\t\tif (!playbackId) return;\n\n\t\t// Only create player if it doesn't already exist in the container\n\t\tif (!container.querySelector('mux-player')) {\n\t\t\t// Create the mux-player element\n\t\t\tconst player = document.createElement('mux-player');\n\t\t\tplayer.setAttribute('playback-id', playbackId);\n\t\t\tplayer.setAttribute('stream-type', 'on-demand');\n\t\t\tplayer.setAttribute('metadata-video-title', videoTitle);\n\t\t\tplayer.setAttribute('primary-color', '#FFFFFF');\n\t\t\tplayer.setAttribute('secondary-color', '#000000');\n\t\t\tplayer.setAttribute('accent-color', '#000000');\n\t\t\tplayer.setAttribute('loading', 'lazy');\n\t\t\tif (thumbnailTime !== null) {\n\t\t\t\tplayer.setAttribute('thumbnail-time', thumbnailTime);\n\t\t\t\tplayer.setAttribute(\n\t\t\t\t\t'poster',\n\t\t\t\t\t`https://image.mux.com/${playbackId}/thumbnail.jpg?time=${thumbnailTime}`,\n\t\t\t\t);\n\t\t\t}\n\t\t\tplayer.style.width = '100%';\n\t\t\tplayer.style.height = 'auto';\n\t\t\tplayer.style.maxWidth = '100%';\n\t\t\tplayer.style.borderRadius = '6px';\n\n\t\t\t// Clear the container and append the player\n\t\t\tcontainer.innerHTML = '';\n\t\t\tcontainer.appendChild(player);\n\t\t}\n\t});\n}\n\n// Run initialization when DOM is loaded\ndocument.addEventListener('DOMContentLoaded', initMuxPlayers);\n\n// Also run when content might be dynamically changed\nwindow.addEventListener('load', initMuxPlayers);\n\n// Set up a MutationObserver to detect when new content is added to the page\nconst observer = new MutationObserver(function (mutations) {\n\tlet shouldInit = false;\n\n\t// Check if relevant mutations occurred\n\tmutations.forEach(function (mutation) {\n\t\tif (mutation.type === 'childList' && mutation.addedNodes.length > 0) {\n\t\t\t// Check if any of the added nodes might contain our player containers\n\t\t\tfor (let i = 0; i < mutation.addedNodes.length; i++) {\n\t\t\t\tconst node = mutation.addedNodes[i];\n\t\t\t\tif (node.nodeType === 1) {\n\t\t\t\t\t// Element node\n\t\t\t\t\t// Check if the node itself is a container\n\t\t\t\t\tif (\n\t\t\t\t\t\tnode instanceof Element &&\n\t\t\t\t\t\tnode.classList &&\n\t\t\t\t\t\tnode.classList.contains('mux-player-container')\n\t\t\t\t\t) {\n\t\t\t\t\t\tshouldInit = true;\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t\t// Check if the node contains containers\n\t\t\t\t\telse if (\n\t\t\t\t\t\tnode instanceof Element &&\n\t\t\t\t\t\ttypeof node.querySelectorAll === 'function'\n\t\t\t\t\t) {\n\t\t\t\t\t\tconst containers = node.querySelectorAll(\n\t\t\t\t\t\t\t'.mux-player-container',\n\t\t\t\t\t\t);\n\t\t\t\t\t\tif (containers.length > 0) {\n\t\t\t\t\t\t\tshouldInit = true;\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t});\n\n\t// Initialize players if needed\n\tif (shouldInit) {\n\t\tsetTimeout(initMuxPlayers, 100);\n\t}\n});\n\n// Start observing the document body for changes\nobserver.observe(document.body, { childList: true, subtree: true });\n\n// For Mintlify's client-side navigation\nif (typeof window !== 'undefined') {\n\twindow.addEventListener('turbolinks:load', initMuxPlayers);\n\twindow.addEventListener('page:load', initMuxPlayers);\n\twindow.addEventListener('spa:page-change', initMuxPlayers);\n}\n"},{"_id":"68dff6bcd349cd094d077b9b","filePath":"reo-dev.js","subdomain":"gitpod-13c83c2b","__v":0,"content":"// @ts-ignore\n!(function () {\n  var e, t, n;\n  (e = '030c76e4f0ed312'),\n    (t = function () {\n      // @ts-ignore\n      Reo.init({ clientID: '030c76e4f0ed312' });\n    }),\n    ((n = document.createElement('script')).src = 'https://static.reo.dev/' + e + '/reo.js'),\n    (n.defer = !0),\n    (n.onload = t),\n    document.head.appendChild(n);\n})();\n"},{"_id":"698af471f9e80a68c4edf8cf","filePath":"llms-note.js","subdomain":"gitpod-13c83c2b","__v":0,"content":"// Injects a subtle \"LLM? Read llms.txt\" note above the page footer,\n// similar to Stripe's docs pattern for llms.txt discoverability.\n(function () {\n  function injectNote() {\n    if (document.getElementById('llms-note')) return;\n\n    var target = document.getElementById('pagination');\n    if (!target) return;\n\n    var note = document.createElement('div');\n    note.id = 'llms-note';\n    note.innerHTML =\n      '<span class=\"llms-note-icon\">✦</span> LLM? Read <a href=\"https://ona.com/docs/llms.txt\">llms.txt</a> or <a href=\"https://ona.com/docs/llms-full.txt\">llms-full.txt</a>.';\n    target.parentNode.insertBefore(note, target.nextSibling);\n  }\n\n  // Run on initial load and on client-side navigation\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectNote);\n  } else {\n    injectNote();\n  }\n\n  // Re-inject on SPA navigation (Mintlify uses Next.js)\n  var observer = new MutationObserver(function () {\n    if (!document.getElementById('llms-note')) {\n      injectNote();\n    }\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n})();\n"}],"recommendPages":[{"title":"Audit logs","link":"ona/audit-logs/overview#cli","breadcrumbs":["Administration & Security","Guardrails","Audit logs"]},{"title":"Guardrails","link":"ona/guardrails/overview#what-guardrails-cover","breadcrumbs":["Administration & Security","Guardrails","Guardrails"]},{"title":"Automation guardrails","link":"ona/automations/guardrails#audit-logging","breadcrumbs":["Using Ona","Automations","Automation guardrails"]}]}}
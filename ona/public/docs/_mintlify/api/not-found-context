dth: 768px) {\n\t#banner span,\n\t#banner p {\n\t\tfont-size: 14px !important;\n\t}\n}\n\n#banner a {\n\ttext-decoration: none !important;\n}\n\n/* Subtle llms.txt note (Stripe-style) */\n#llms-note {\n\tmargin-top: 2rem;\n\tpadding-top: 1.25rem;\n\tborder-top: 1px solid rgba(0, 0, 0, 0.08);\n\tfont-size: 0.8125rem;\n\tline-height: 1.25rem;\n\tcolor: rgba(0, 0, 0, 0.9);\n}\n\n.dark #llms-note {\n\tborder-top-color: rgba(255, 255, 255, 0.12);\n\tcolor: rgba(255, 255, 255, 0.9);\n}\n\n#llms-note a {\n\tcolor: rgba(0, 0, 0, 0.75);\n\ttext-decoration: underline;\n\ttext-decoration-color: rgba(0, 0, 0, 0.25);\n\ttext-underline-offset: 2px;\n\ttransition: color 0.15s, text-decoration-color 0.15s;\n}\n\n.dark #llms-note a {\n\tcolor: rgba(255, 255, 255, 0.7);\n\ttext-decoration-color: rgba(255, 255, 255, 0.25);\n}\n\n#llms-note a:hover {\n\tcolor: rgba(0, 0, 0, 0.9);\n\ttext-decoration-color: rgba(0, 0, 0, 0.5);\n}\n\n.dark #llms-note a:hover {\n\tcolor: rgba(255, 255, 255, 0.95);\n\ttext-decoration-color: rgba(255, 255, 255, 0.5);\n}\n\n.llms-note-icon {\n\tmargin-right: 0.25rem;\n}\n\n/* Overview page cards with hero image hover effect */\n.overview-cards {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(2, 1fr);\n\tgap: 16px;\n}\n\n@media (max-width: 768px) {\n\t.overview-cards {\n\t\tgrid-template-columns: 1fr;\n\t}\n}\n\n.overview-cards .overview-card {\n\tposition: relative;\n\toverflow: hidden;\n\tborder-radius: 12px;\n\tborder: 1px solid rgba(0, 0, 0, 0.08);\n\tpadding: 24px;\n\ttext-decoration: none !important;\n\tcolor: inherit !important;\n\tdisplay: block;\n\ttransition: border-color 0.2s;\n\tisolation: isolate;\n}\n\n.dark .overview-cards .overview-card {\n\tborder-color: rgba(255, 255, 255, 0.1);\n}\n\n.overview-cards .overview-card::before {\n\tcontent: '';\n\tposition: absolute;\n\ttop: 0;\n\tright: 0;\n\tbottom: 0;\n\tleft: 0;\n\tbackground-image: url('https://ona.com/docs/assets/screenshot-bg.jpg');\n\tbackground-size: cover;\n\tbackground-position: ce